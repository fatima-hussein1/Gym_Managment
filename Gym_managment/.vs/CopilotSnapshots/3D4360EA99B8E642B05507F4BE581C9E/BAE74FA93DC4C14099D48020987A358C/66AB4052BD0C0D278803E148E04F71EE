Imports MaterialSkin
Imports System.Drawing

Public Class frmlogin

    Private Sub Form1_Load(sender As Object, e As EventArgs) Handles MyBase.Load
        ' تهيئة MaterialSkinManager
        Dim SkinManager As MaterialSkinManager = MaterialSkinManager.Instance

        ' إضافة النموذج الحالي للمدير
        SkinManager.AddFormToManage(Me)

        ' تحديد السمة إلى داكنة (DARK) لواجهة احترافية
        SkinManager.Theme = MaterialSkinManager.Themes.LIGHT

        ' تغيير مخطط الألوان: استبدال Amber البرتقالي إلى Indigo حديث واحترافي
        SkinManager.ColorScheme = New ColorScheme(
            Primary.Indigo500,
            Primary.Indigo700,
            Primary.Indigo100,
            Accent.LightBlue200,
            TextShade.WHITE
        )

        ' تعيين خط Times New Roman بحجم 14 على الفورم وكل الأدوات
        Dim appFont As New Font("Times New Roman", 14.0F, FontStyle.Regular)
        Me.Font = appFont
        ApplyFontToControls(Me, appFont)
    End Sub

    Private Sub ApplyFontToControls(parent As Control, f As Font)
        For Each c As Control In parent.Controls
            Try
                c.Font = f
            Catch
                ' Ignore controls that don't accept font changes
            End Try
            If c.HasChildren Then
                ApplyFontToControls(c, f)
            End If
        Next
    End Sub

    Private Sub BtnOk_Click(sender As Object, e As EventArgs) Handles BtnOk.Click

    End Sub
End Class
