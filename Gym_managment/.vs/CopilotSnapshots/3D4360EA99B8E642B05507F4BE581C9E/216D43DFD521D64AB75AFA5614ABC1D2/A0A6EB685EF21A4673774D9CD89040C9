Imports Microsoft.Data.SqlClient

Public Class FrmMemberEdit
    Private MemberID As Integer = 0

    Public Sub LoadMember(id As Integer)
        MemberID = id
        Try
            OpenCon()
            Dim cmd As New SqlCommand("SELECT FirstName, LastName, PhoneNumber, JoinDate FROM Members WHERE MemberID=@id", con)
            cmd.Parameters.AddWithValue("@id", id)
            Dim rdr As SqlDataReader = cmd.ExecuteReader()
            If rdr.Read() Then
                txtFirst.Text = rdr("FirstName").ToString()
                txtLast.Text = rdr("LastName").ToString()
                txtPhone.Text = rdr("PhoneNumber").ToString()
                dtpJoin.Value = Date.Parse(rdr("JoinDate").ToString())
            End If
            rdr.Close()
            CloseCon()
        Catch ex As Exception
            MessageBox.Show("خطأ في تحميل بيانات العضو: " & ex.Message)
        End Try
    End Sub

    Private Sub btnSave_Click(sender As Object, e As EventArgs) Handles btnSave.Click
        Try
            OpenCon()
            Dim cmd As SqlCommand
            If MemberID = 0 Then
                cmd = New SqlCommand("INSERT INTO Members(FirstName, LastName, PhoneNumber, JoinDate, AddedByUserID) VALUES(@f,@l,@p,@j,@u)", con)
                cmd.Parameters.AddWithValue("@u", DBNull.Value)
            Else
                cmd = New SqlCommand("UPDATE Members SET FirstName=@f, LastName=@l, PhoneNumber=@p, JoinDate=@j WHERE MemberID=@id", con)
                cmd.Parameters.AddWithValue("@id", MemberID)
            End If
            cmd.Parameters.AddWithValue("@f", txtFirst.Text)
            cmd.Parameters.AddWithValue("@l", txtLast.Text)
            cmd.Parameters.AddWithValue("@p", txtPhone.Text)
            cmd.Parameters.AddWithValue("@j", dtpJoin.Value.Date)
            cmd.ExecuteNonQuery()
            CloseCon()
            Me.DialogResult = DialogResult.OK
            Me.Close()
        Catch ex As Exception
            MessageBox.Show("خطأ في حفظ بيانات العضو: " & ex.Message)
        End Try
    End Sub

    Private Sub btnCancel_Click(sender As Object, e As EventArgs) Handles btnCancel.Click
        Me.DialogResult = DialogResult.Cancel
        Me.Close()
    End Sub
End Class