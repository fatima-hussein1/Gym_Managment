    Private Sub ApplyFontToControls(parent As Control, f As Font)
        For Each c As Control In parent.Controls
            Try
                c.Font = f
            Catch
                ' ignore
            End Try
            If c.HasChildren Then
                ApplyFontToControls(c, f)
            End If
        Next
    End Sub

