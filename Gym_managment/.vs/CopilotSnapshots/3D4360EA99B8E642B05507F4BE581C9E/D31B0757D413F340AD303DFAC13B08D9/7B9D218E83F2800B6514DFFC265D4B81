    Private Sub FrmMain_Load(sender As Object, e As EventArgs) Handles MyBase.Load
        ThemeManager.Initialize()
        ThemeManager.ApplyTheme(Me)

        ' تعيين خط Times New Roman بحجم 14 على الفورم وكل الأدوات
        Dim appFont As New Font("Times New Roman", 14.0F, FontStyle.Regular)
        Me.Font = appFont
        ApplyFontToControls(Me, appFont)

        ' Initialize radio buttons state
        If ThemeManager.Mode = ThemeManager.ThemeMode.Dark Then
            If rbDark IsNot Nothing Then rbDark.Checked = True
        Else
            If rbLight IsNot Nothing Then rbLight.Checked = True
        End If
    End Sub

    Private Sub rbDark_CheckedChanged(sender As Object, e As EventArgs) Handles rbDark.CheckedChanged
        If rbDark.Checked Then
            ThemeManager.Mode = ThemeManager.ThemeMode.Dark
            ThemeManager.ApplyTheme(Me)
        End If
    End Sub

    Private Sub rbLight_CheckedChanged(sender As Object, e As EventArgs) Handles rbLight.CheckedChanged
        If rbLight.Checked Then
            ThemeManager.Mode = ThemeManager.ThemeMode.Light
            ThemeManager.ApplyTheme(Me)
        End If
    End Sub

