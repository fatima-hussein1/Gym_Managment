    Private Sub FrmLogin_Load(sender As Object, e As EventArgs) Handles MyBase.Load
        SWForm = True

        Try
            ' Select users and alias columns to match older schema expected by the login logic
            SQLQuery = "SELECT UserID AS ID, Username AS UserName, PasswordHash AS UserPass, FullName AS UserJob, IsActive, RoleID FROM Users WHERE 1=1"
            DA = New SqlDataAdapter(SQLQuery, con)
            DT = New DataTable
            DA.Fill(DT)

            ' Bind to combo (ensure control name CmbUserName exists in designer)
            CmbUserName.DataSource = DT
            CmbUserName.DisplayMember = "UserName"
            CmbUserName.ValueMember = "ID"

            If My.Settings.SelectedUser <= CmbUserName.Items.Count - 1 AndAlso My.Settings.SelectedUser >= 0 Then
                CmbUserName.SelectedIndex = My.Settings.SelectedUser
            Else
                My.Settings.SelectedUser = -1
                My.Settings.Save()
            End If

            SWForm = False
        Catch ex As Exception
            MsgBox("فشل في الإتصال بقاعدة البيانات: " & ex.Message, MsgBoxStyle.Critical, "خطأ إتصال")
        End Try
    End Sub

    Private Sub CmbUserName_SelectionChangeCommitted(sender As Object, e As EventArgs) Handles CmbUserName.SelectionChangeCommitted
        My.Settings.SelectedUser = CmbUserName.SelectedIndex
        My.Settings.Save()
        TxtPasswprd.Text = ""
        TxtPasswprd.Focus()
    End Sub

    Private Sub FrmLogin_Closing(sender As Object, e As CancelEventArgs) Handles Me.Closing
        Try
            My.Settings.SelectedUser = CmbUserName.SelectedIndex
            My.Settings.Save()
        Catch
        End Try
    End Sub

    Private Sub BtnOK_Click(sender As Object, e As EventArgs) Handles BtnOK.Click
        If CmbUserName.Text.Trim = "" Then
            MsgBox("يرجى ادخال اسم المستخدم", MsgBoxStyle.Exclamation + vbOKOnly, "خطأ في الدخول")
            CmbUserName.Focus()
            Exit Sub
        End If
        If TxtPasswprd.Text.Trim = "" Then
            MsgBox("يرجى ادخال كلمة المرور", MsgBoxStyle.Exclamation + vbOKOnly, "خطأ في الدخول")
            TxtPasswprd.Focus()
            Exit Sub
        End If

        Try
            ' Use DataTable filter to check credentials (UserPass currently holds PasswordHash or plaintext depending on DB)
            Dim filter As String = "UserName='" & CmbUserName.Text.Replace("'", "''") & "' AND UserPass='" & TxtPasswprd.Text.Replace("'", "''") & "'"
            Dim ItemRows() As DataRow = DT.Select(filter)
            If ItemRows.Length > 0 Then
                ' Map to global current user variables
                CurrentUserID = Convert.ToInt32(ItemRows(0)("ID"))
                CurrentUsername = ItemRows(0)("UserName").ToString()
                CurrentFullName = If(ItemRows(0)("UserJob") Is DBNull.Value, CurrentUsername, ItemRows(0)("UserJob").ToString())

                ' Load permissions into global DTUserPermission
                Try
                    DTUserPermission.Clear()
                    SQLQuery = "SELECT * FROM PermissionTable WHERE UserID=" & CurrentUserID
                    DA = New SqlDataAdapter(SQLQuery, con)
                    DA.Fill(DTUserPermission)
                Catch ex As Exception
                    MsgBox("خطأ في تحميل صلاحيات المستخدم: " & ex.Message, MsgBoxStyle.Critical, "خطأ إتصال بقاعدة البيانات")
                End Try

                SWForm = False
                swactive = True
                SetPermission()
                Me.Dispose()
            Else
                MsgBox("كلمة المرور غير صحيحة  يرجى اعادة المحاولة", MsgBoxStyle.Exclamation, "خطأ في الدخول")
                TxtPasswprd.Text = ""
                TxtPasswprd.Focus()
            End If
        Catch ex As Exception
            MsgBox("خطأ أثناء عملية الدخول: " & ex.Message, MsgBoxStyle.Critical, "خطأ")
        End Try
    End Sub

