    Private Sub UserConnectMonitor()
        If CurrentUserID = 0 Then
            Exit Sub
        End If

        Try
            CMD = New SqlCommand("UserConnectMonitor", con)
            CMD.CommandType = CommandType.StoredProcedure
            Dim param As SqlParameter
            param = New SqlParameter("@UserID", CurrentUserID)
            CMD.Parameters.Add(param)
            CMD.Parameters.Add("@MsgCount", SqlDbType.Int).Direction = ParameterDirection.Output
            CMD.Parameters.Add("@UserLockedOut", SqlDbType.Int).Direction = ParameterDirection.Output

            OpenCon()
            CMD.ExecuteNonQuery()
            CloseCon()

            Dim MsgCount As Integer = CMD.Parameters("@MsgCount").Value.ToString()

            If MsgCount <> 0 And FrmMessenger.IsHandleCreated = False And MsgCount <> Val(LbLTotalMsgCount.Text) Then
                LbLTotalMsgCount.Text = MsgCount
            ElseIf MsgCount = 0 Then
                LbLTotalMsgCount.Text = ""
            End If
            Dim UserLockedOut As Integer = CMD.Parameters("@UserLockedOut").Value.ToString()
            If UserLockedOut = 1 Then
                MsgBox("تم ايقافك عن العمل على المنظومة من قبل المسؤول", MsgBoxStyle.Critical, "ايقاف")
                Close()
            End If
        Catch ex As Exception
            CloseCon()
            MsgBox("خطأ في تحديث بيانت اتصال المستخدم" + ex.Message, MsgBoxStyle.Critical, "خطأ إتصال بقواعد البيانات")
        End Try

    End Sub

