        End If
    End Sub

    Public Sub GetTreasury()
        Try
            dtTreasury = New DataTable
            SQLQuery = "Select * From treasury_nameTABLE"
            DA = New SqlDataAdapter(SQLQuery, con)
            DA.Fill(dtTreasury)
            If TreasuryName IsNot Nothing Then
                With TreasuryName
                    .DataSource = dtTreasury
                    .ValueMember = "treasury_id"
                    .DisplayMember = "treasury_name"
                    .SelectedIndex = -1
                End With
            End If
        Catch ex As Exception
            MsgBox("خطأ في تحميل بيانات الخزينة" + ex.Message, MsgBoxStyle.Critical, "خطأ إتصال بقواعد البيانات")
        End Try
    End Sub

