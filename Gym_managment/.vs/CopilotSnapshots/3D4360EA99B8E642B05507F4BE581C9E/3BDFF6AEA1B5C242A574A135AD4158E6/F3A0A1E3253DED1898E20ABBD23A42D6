    Sub count_invoice()
        Try
            Dim str = "select COUNT(id) from Service_InvoTable where InvoDate = @d"
            Dim cmd As New SqlCommand(str, con)
            cmd.Parameters.AddWithValue("@d", Format(Date.Now, "yyyy/MM/dd"))
            Dim da As New SqlDataAdapter(cmd)
            Dim dta As New DataTable("Service_InvoTable")
            da.Fill(dta)

            Dim sumdebit As Decimal = 0.0
            If dta.Rows.Count > 0 AndAlso Not IsDBNull(dta.Rows(0).Item(0)) Then sumdebit = dta.Rows(0).Item(0)
            If Me.Controls.ContainsKey("Servicecount") Then
                Dim lbl = TryCast(Me.Controls.Find("Servicecount", True).FirstOrDefault(), System.Windows.Forms.Label)
                If lbl IsNot Nothing Then lbl.Text = Val(sumdebit)
            End If
        Catch ex As Exception
            ' ignore or log
        End Try
    End Sub

