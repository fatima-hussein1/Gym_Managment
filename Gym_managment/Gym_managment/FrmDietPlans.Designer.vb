    Private Sub StyleButton(btn As Guna.UI2.WinForms.Guna2Button, text As String, fill As Color)
        btn.BorderRadius = 10
        btn.FillColor = fill
        btn.Font = New Font("Segoe UI", 10.0F, FontStyle.Bold)
        btn.ForeColor = Color.White
        btn.Size = New Size(247, 40)
        btn.Text = text
    End Sub

    Private Sub SetupFieldLabel(lbl As Label, text As String, loc As Point, accent As Color)
        lbl.AutoSize = True
        lbl.Font = New Font("Times New Roman", 12.0F, FontStyle.Bold)
        lbl.ForeColor = accent
        lbl.Location = loc
        lbl.Text = text
    End Sub

