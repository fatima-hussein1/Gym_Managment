    Private Sub StyleTextBox(tb As Guna.UI2.WinForms.Guna2TextBox, placeholder As String)
        tb.BorderRadius = 8
        tb.BorderColor = Color.FromArgb(CByte(0), CByte(200), CByte(190))
        tb.FillColor = Color.FromArgb(CByte(8), CByte(16), CByte(60))
        tb.ForeColor = Color.White
        tb.PlaceholderForeColor = Color.FromArgb(CByte(180), CByte(180), CByte(180))
        tb.PlaceholderText = placeholder
        tb.Size = New Size(247, 46)
        tb.RightToLeft = RightToLeft.Yes
    End Sub

    Private Sub StyleButton(btn As Guna.UI2.WinForms.Guna2Button, text As String, fill As Color)
        btn.BorderRadius = 10
        btn.FillColor = fill
        btn.Font = New Font("Segoe UI", 10.0F, FontStyle.Bold)
        btn.ForeColor = Color.White
        btn.Size = New Size(247, 40)
        btn.Text = text
    End Sub

    Private Sub StyleCombo(cmb As Guna.UI2.WinForms.Guna2ComboBox)
        cmb.BorderRadius = 8
        cmb.BorderColor = Color.FromArgb(CByte(0), CByte(200), CByte(190))
        cmb.FillColor = Color.FromArgb(CByte(8), CByte(16), CByte(60))
        cmb.ForeColor = Color.White
        cmb.DrawMode = DrawMode.OwnerDrawFixed
        cmb.DropDownStyle = ComboBoxStyle.DropDownList
        cmb.ItemHeight = 30
        cmb.Size = New Size(247, 36)
        cmb.RightToLeft = RightToLeft.Yes
    End Sub

    Private Sub SetupFieldLabel(lbl As Label, text As String, loc As Point, accent As Color)
        lbl.AutoSize = True
        lbl.Font = New Font("Times New Roman", 12.0F, FontStyle.Bold)
        lbl.ForeColor = accent
        lbl.Location = loc
        lbl.Text = text
    End Sub

